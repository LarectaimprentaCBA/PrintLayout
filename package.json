{
  "name": "printlayout",
  "version": "0.1.119",
  "description": "PrintLayout — herramienta de imposición de fotos, tarjetas y stickers para impresión y corte. Desarrollada por La Recta Imprenta (Córdoba, AR) para uso interno.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "La Recta Imprenta",
    "email": "info@larectaimprenta.com.ar"
  },
  "homepage": "https://github.com/LarectaimprentaCBA/PrintLayout",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5174 && cross-env NODE_ENV=development electron .",
    "dev": "node scripts/write-templates-config.cjs && concurrently -k -n VITE,ELECTRON -c blue,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "build:vite": "vite build",
    "build": "node scripts/write-templates-config.cjs && vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-packager . PrintLayout --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(release|src|build|scripts|public|templates-pdf|.vscode|.git|.idea)($|/)\" --ignore=\"^/(vite.config|tailwind.config|postcss.config|index.html|proyecto.txt|.gitignore)$\"",
    "shortcut": "node scripts/create-shortcut.cjs",
    "dist": "npm run pack && npm run shortcut",
    "installer": "npm run build && electron-builder --win nsis",
    "release": "npm run build && electron-builder --win nsis --publish always",
    "test:bleed": "node src/lib/__tests__/imageBleed.test.mjs",
    "test:dobble": "node src/dobble/__tests__/buildDobbleJob.smoke.mjs",
    "test:dobble-intake": "node electron/intake/__tests__/dobble-intake.test.cjs",
    "evidence:dobble": "electron src/dobble/__tests__/gen-evidence.cjs",
    "evidence:dobble-combo": "electron src/dobble/__tests__/gen-evidence-combo.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "clipper-lib": "^6.4.2",
    "electron-updater": "^6.8.3",
    "face-api.js": "^0.22.2",
    "fontkit": "^2.0.4",
    "heic-to": "^1.5.2",
    "imagetracerjs": "^1.2.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "potrace": "^2.1.8",
    "qrcode-generator": "1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.larectaimprenta.printlayout",
    "productName": "PrintLayout",
    "copyright": "Copyright (c) 2026 La Recta Imprenta",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ghostscript",
        "to": "ghostscript",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "helper/PrintHelper.exe",
        "to": "PrintHelper.exe"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PrintLayout-Setup-${version}.${ext}",
      "certificateFile": "build/codesign.pfx",
      "certificatePassword": "PrintLayoutLR2026",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "publisherName": "La Recta Imprenta",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintLayout",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "LarectaimprentaCBA",
      "repo": "PrintLayout",
      "private": true
    }
  }
}
